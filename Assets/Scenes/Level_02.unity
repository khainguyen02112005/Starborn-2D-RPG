--- !u!114 &249372848
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 249372847}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d16c9300f4fe4741a08ff5953a7a995, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  role: 0
  dialoguePanel: {fileID: 830080935}
  dialogueText: {fileID: 1601950789}
  speakerText: {fileID: 1045848632}
  speakerName: "TR\u01AF\u1EDENG L\xC0NG"
  lines:
  - ha
  - he
  - hu
  typingSpeed: 0.05
  endingDirector: {fileID: 1241634559}
  notStartedLines:
  - "TR\u01AF\u1EDENG L\xC0NG|Cu\u1ED1i c\xF9ng th\xEC c\u1EADu c\u0169ng tr\u1EDF
    v\u1EC1. Ngo\xE0i l\xE0ng d\u1EA1o g\u1EA7n \u0111\xE2y xu\u1EA5t hi\u1EC7n ng\xE0y
    c\xE0ng nhi\u1EC1u qu\xE1i v\u1EADt."
  - "NH\xC2N V\u1EACT|T\xF4i v\u1EEBa g\u1EB7p m\u1ED9t \u0111\xE1m qu\xE1i v\u1EADt
    tr\xEAn \u0111\u01B0\u1EDDng v\u1EC1. C\xF3 v\u1EBB ch\xFAng \u0111ang ti\u1EBFn
    g\u1EA7n h\u01A1n \u0111\u1EBFn l\xE0ng."
  - "TR\u01AF\u1EDENG L\xC0NG|Ta lo r\u1EB1ng \u0111\xF3 m\u1EDBi ch\u1EC9 l\xE0
    kh\u1EDFi \u0111\u1EA7u. Ph\xEDa sau l\xE0ng c\xF2n v\xE0i con r\u1EA5t hung
    d\u1EEF, ng\u01B0\u1EDDi d\xE2n \u0111ang c\u1ED1 ng\u0103n ch\xFAng l\u1EA1i."
  - "TR\u01AF\u1EDENG L\xC0NG|H\xE3y ra ngo\xE0i \u0111\xF3 v\xE0 ti\xEAu di\u1EC7t
    3 con qu\xE1i v\u1EADt. Ta s\u1EBD tr\u1EA3 c\xF4ng h\u1EADu h\u0129nh cho c\u1EADu."
  - "TR\u01AF\u1EDENG L\xC0NG|Khi ho\xE0n th\xE0nh, h\xE3y quay l\u1EA1i g\u1EB7p
    ta. Ph\u1EA7n th\u01B0\u1EDFng l\xE0 10 \u0111\u1ED3ng v\xE0ng."
  huntingLines:
  - "TR\u01AF\u1EDENG L\xC0NG|C\u1EADu \u0111\xE3 h\u1EA1 {killed}/{target} con qu\xE1i
    v\u1EADt."
  - "TR\u01AF\u1EDENG L\xC0NG|H\xE3y c\u1EA9n th\u1EADn v\xE0 quay l\u1EA1i khi con
    \u0111\u01B0\u1EDDng \u0111\xE3 an to\xE0n."
  readyToTurnInLines:
  - "TR\u01AF\u1EDENG L\xC0NG|C\u1EADu tr\u1EDF v\u1EC1 r\u1ED3i \xE0. Ta c\xF3 th\u1EC3
    nh\xECn th\u1EA5y d\u1EA5u v\u1EBFt c\u1EE7a tr\u1EADn chi\u1EBFn tr\xEAn ng\u01B0\u1EDDi
    c\u1EADu."
  - "NH\xC2N V\u1EACT|Ba con qu\xE1i v\u1EADt \u0111\xE3 b\u1ECB ti\xEAu di\u1EC7t.
    Khu v\u1EF1c quanh l\xE0ng t\u1EA1m th\u1EDDi an to\xE0n r\u1ED3i."
  - "TR\u01AF\u1EDENG L\xC0NG|L\xE0m t\u1ED1t l\u1EAFm. \u0110\xE2y l\xE0 10 \u0111\u1ED3ng
    v\xE0ng nh\u01B0 ta \u0111\xE3 h\u1EE9a."
  - "TR\u01AF\u1EDENG L\xC0NG|H\xE3y ngh\u1EC9 ng\u01A1i \u0111i. Ta c\xF3 c\u1EA3m
    gi\xE1c chuy\u1EC7n n\xE0y v\u1EABn ch\u01B0a k\u1EBFt th\xFAc."
  royalNoticeLines:
  - "H\u1EC6 TH\u1ED0NG|M\u1ED9t ng\xE0y sau\u2026"
  - "TR\u01AF\u1EDENG L\xC0NG|C\u1EADu \u0111\u1EBFn \u0111\xFAng l\xFAc. S\xE1ng
    nay, s\u1EE9 gi\u1EA3 c\u1EE7a nh\xE0 vua v\u1EEBa mang \u0111\u1EBFn m\u1ED9t
    s\u1EAFc l\u1EC7nh."
  - "NH\xC2N V\u1EACT|C\xF3 chuy\u1EC7n g\xEC x\u1EA3y ra sao?"
  - "TR\u01AF\u1EDENG L\xC0NG|M\u1ED9t con qu\xE1i v\u1EADt kh\u1ED5ng l\u1ED3 \u0111\xE3
    xu\u1EA5t hi\u1EC7n t\u1EA1i v\xF9ng \u0111\u1EA5t ph\xEDa b\xEAn kia khu r\u1EEBng."
  - "TR\u01AF\u1EDENG L\xC0NG|Nh\xE0 vua tuy\xEAn b\u1ED1 r\u1EB1ng b\u1EA5t k\u1EF3
    ai ti\xEAu di\u1EC7t \u0111\u01B0\u1EE3c n\xF3 s\u1EBD nh\u1EADn \u0111\u01B0\u1EE3c
    m\u1ED9t \u0111i\u1EC1u \u01B0\u1EDBc."
  - "NH\xC2N V\u1EACT|M\u1ED9t \u0111i\u1EC1u \u01B0\u1EDBc\u2026 b\u1EA5t k\u1EF3
    \u0111i\u1EC1u g\xEC sao?"
  - "TR\u01AF\u1EDENG L\xC0NG|\u0110\xF3 l\xE0 nh\u1EEFng g\xEC \u0111\u01B0\u1EE3c
    vi\u1EBFt trong s\u1EAFc l\u1EC7nh. Nh\u01B0ng r\u1EA5t nhi\u1EC1u chi\u1EBFn
    binh \u0111\xE3 \u0111\u1EBFn \u0111\xF3 v\xE0 kh\xF4ng ai quay tr\u1EDF v\u1EC1."
  - "NH\xC2N V\u1EACT|N\u1EBFu con qu\xE1i v\u1EADt \u0111\xF3 c\xF3 th\u1EC3 \u0111e
    d\u1ECDa ng\xF4i l\xE0ng th\xEC t\xF4i kh\xF4ng th\u1EC3 \u0111\u1EE9ng y\xEAn
    \u0111\u01B0\u1EE3c."
  - "TR\u01AF\u1EDENG L\xC0NG|Ta bi\u1EBFt c\u1EADu s\u1EBD n\xF3i nh\u01B0 v\u1EADy.
    H\xE3y chu\u1EA9n b\u1ECB th\u1EADt k\u1EF9 r\u1ED3i \u0111i theo con \u0111\u01B0\u1EDDng
    ph\xEDa b\u1EAFc."
  bossQuestLines:
  - "TR\u01AF\u1EDENG L\xC0NG|Con \u0111\u01B0\u1EDDng ph\xEDa b\u1EAFc d\u1EABn
    \u0111\u1EBFn v\xF9ng \u0111\u1EA5t qu\xE1i v\u1EADt. \u1EDE \u0111\xF3 c\xF3
    c\u1EA3 qu\xE1i th\u01B0\u1EDDng l\u1EABn qu\xE1i tinh anh."
  - "TR\u01AF\u1EDENG L\xC0NG|H\xE3y n\xE2ng c\u1EA5p trang b\u1ECB v\xE0 k\u1EF9
    n\u0103ng tr\u01B0\u1EDBc khi ti\u1EBFn v\xE0o s\xE0o huy\u1EC7t c\u1EE7a Boss."
  bossTurnInNoDeathLines:
  - "TR\u01AF\u1EDENG L\xC0NG|C\u1EADu \u0111\xE3 tr\u1EDF v\u1EC1! Tin t\u1EE9c
    v\u1EC1 chi\u1EBFn th\u1EAFng c\u1EE7a c\u1EADu \u0111\xE3 \u0111\u1EBFn ho\xE0ng
    cung."
  - "TR\u01AF\u1EDENG L\xC0NG|Nh\xE0 vua s\u1EBD th\u1EF1c hi\u1EC7n \u0111i\u1EC1u
    \u01B0\u1EDBc nh\u01B0 \u0111\xE3 h\u1EE9a. H\xE3y n\xF3i \u0111i, c\u1EADu mong
    mu\u1ED1n \u0111i\u1EC1u g\xEC?"
  bossTurnInAfterDeathLines:
  - "TR\u01AF\u1EDENG L\xC0NG|C\u1EADu \u0111\xE3 tr\u1EDF v\u1EC1! Tin t\u1EE9c
    v\u1EC1 chi\u1EBFn th\u1EAFng c\u1EE7a c\u1EADu \u0111\xE3 \u0111\u1EBFn ho\xE0ng
    cung."
  - "TR\u01AF\u1EDENG L\xC0NG|Nh\xE0 vua s\u1EBD th\u1EF1c hi\u1EC7n \u0111i\u1EC1u
    \u01B0\u1EDBc nh\u01B0 \u0111\xE3 h\u1EE9a. H\xE3y n\xF3i \u0111i, c\u1EADu mong
    mu\u1ED1n \u0111i\u1EC1u g\xEC?"
  completedLines:
  - "\u0110i\u1EC1u \u01B0\u1EDBc \u0111\xE3 \u0111\u01B0\u1EE3c trao. C\xE2u chuy\u1EC7n
    \u0111ang b\u1EAFt \u0111\u1EA7u r\u1EA1n v\u1EE1..."
  endingNoDeathLines:
  - "Ng\u01B0\u01A1i \u0111\xE3 ti\xEAu di\u1EC7t Ch\xFAa T\u1EC3 L\xF4i Th\xFA m\xE0
    ch\u01B0a m\u1ED9t l\u1EA7n g\u1EE5c ng\xE3."
  - "Theo chi\u1EBFu ch\u1EC9 c\u1EE7a nh\xE0 vua, h\xE3y n\xF3i \u0111i\u1EC1u \u01B0\u1EDBc
    c\u1EE7a ng\u01B0\u01A1i."
  endingAfterDeathLines:
  - "Ng\u01B0\u01A1i \u0111\xE3 tr\u1EDF v\u1EC1... nh\u01B0ng \xE1nh m\u1EAFt \u1EA5y
    kh\xF4ng c\xF2n gi\u1ED1ng tr\u01B0\u1EDBc kia."
  - "Theo chi\u1EBFu ch\u1EC9, ng\u01B0\u01A1i \u0111\u01B0\u1EE3c ban m\u1ED9t \u0111i\u1EC1u
    \u01B0\u1EDBc. Ng\u01B0\u01A1i mu\u1ED1n g\xEC?"
  - "\u0110\u01B0\u1EE3c gi\u1EA3i tho\xE1t \u01B0? Ta... kh\xF4ng hi\u1EC3u ng\u01B0\u01A1i
    \u0111ang n\xF3i g\xEC."
  - "Ta kh\xF4ng hi\u1EC3u... Ta kh\xF4ng hi\u1EC3u... Ta kh\xF4ng hi\u1EC3u..."
