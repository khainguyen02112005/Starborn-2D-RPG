  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCBlacksmith
  craftingPanel: {fileID: 423473196}
  craftedSwordData: {fileID: 11400000, guid: b14eb8d6c9b21a240805c9b64b535b95, type: 2}
  craftedStaffData: {fileID: 11400000, guid: 7180ac456b86add438fc2bd69faca128, type: 2}
  dialoguePanel: {fileID: 830080935}
  dialogueText: {fileID: 1601950789}
  speakerText: {fileID: 1045848632}
  speakerName: "TH\u1EE2 R\xC8N"
  dialogueLines:
  - "Nh\xECn v\u0169 kh\xED c\u1EE7a ng\u01B0\u01A1i k\xECa. N\u1EBFu c\u1EE9 chi\u1EBFn
    \u0111\u1EA5u nh\u01B0 v\u1EADy, n\xF3 s\u1EBD s\u1EDBm g\xE3y m\u1EA5t."
  - "C\xF3 \u0111\u1EE7 nguy\xEAn li\u1EC7u v\xE0 v\xE0ng th\xEC chuy\u1EC7n g\xEC
    ta c\u0169ng l\xE0m \u0111\u01B0\u1EE3c."
  - "Ki\u1EBFm d\xE0nh cho hi\u1EC7p s\u0129. G\u1EADy ph\xE9p d\xE0nh cho ph\xE1p
    s\u01B0. \u0110\u1EEBng c\u1EA7m nh\u1EA7m r\u1ED3i tr\xE1ch ta."
  typingSpeed: 0.025
  oreCost: 3
  repairCost: 50
