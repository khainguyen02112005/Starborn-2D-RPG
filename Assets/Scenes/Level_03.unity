  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RespawnWhisperBubble
  visibleSeconds: 2.65
  worldOffset: {x: 0, y: 2.15, z: 0}
  earlyLines:
  - "\u0110au qu\xE1\u2026"
  - "C\u1EA3m gi\xE1c \u0111\xF3\u2026 ch\xE2n th\u1EADt qu\xE1."
  - "\u0110\u1EA7u m\xECnh \u0111au qu\xE1\u2026"
  - "Sao c\u01A1 th\u1EC3 m\xECnh n\u1EB7ng th\u1EBF n\xE0y?"
  middleLines:
  - "L\u1EA1i l\xE0 c\u1EA3m gi\xE1c n\xE0y\u2026"
  - "T\u1EA1i sao m\xECnh v\u1EABn nh\u1EDB c\u01A1n \u0111au \u0111\xF3?"
  - "C\u01A1 th\u1EC3 \u0111\xE3 l\xE0nh\u2026 nh\u01B0ng sao v\u1EABn c\xF2n \u0111au?"
  - "C\xF3 c\u1EA3m gi\xE1c nh\u01B0 m\xECnh v\u1EEBa b\u1ECB k\xE9o tr\u1EDF l\u1EA1i."
  cursorHintLines:
  - "H\u1EEDm\u2026 c\xE1i g\xEC v\u1EEBa di chuy\u1EC3n v\u1EADy?"
  - "C\xF3 g\xEC \u0111\xF3 \u1EDF g\u1EA7n \u0111\xE2y sao?"
  - "T\u1EA1i sao m\xECnh l\u1EA1i mu\u1ED1n \u0111i v\u1EC1 h\u01B0\u1EDBng \u0111\xF3?"
  - "Tay m\xECnh\u2026 v\u1EEBa t\u1EF1 c\u1EED \u0111\u1ED9ng sao?"
  lateLines:
  - "L\u1EA1i n\u1EEFa\u2026"
  - "M\xECnh kh\xF4ng mu\u1ED1n \u0111\u1EE9ng d\u1EADy n\u1EEFa."
  - "\xCDt nh\u1EA5t\u2026 cho m\xECnh n\u1EB1m y\xEAn m\u1ED9t l\xFAc \u0111\u01B0\u1EE3c
    kh\xF4ng?"
  - "C\xF3 th\u1EE9 g\xEC \u0111\xF3 kh\xF4ng cho ph\xE9p m\xECnh d\u1EEBng l\u1EA1i."
