  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 780ddf4809df2a24a941bda7294e9746, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicEventMarker
  m_Time: 39
  action: 0
  speaker: "NH\xC2N V\u1EACT"
  line: "Ta kh\xF4ng mu\u1ED1n tr\u1EDF th\xE0nh qu\xE1i v\u1EADt. Nh\u01B0ng ta
    ch\u1EC9 c\xF2n m\u1ED9t c\xE1ch: x\xF3a m\u1ECDi th\u1EE9 \u0111\u1EBFn khi
    kh\xF4ng c\xF2n m\u1ED9t pixel n\xE0o gi\u1EEF ta l\u1EA1i."
  variant: 0
