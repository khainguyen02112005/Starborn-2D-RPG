  m_Time: 1.85
  action: 0
  speaker: "TR\u01AF\u1EDENG L\xC0NG"
  line: "Gi\u1EA3i tho\xE1t? Ta kh\xF4ng hi\u1EC3u. C\u1EADu \u0111\xE3 \u0111\xE1nh
    b\u1EA1i con qu\xE1i v\u1EADt v\xE0 c\u1EE9u t\u1EA5t c\u1EA3 ch\xFAng ta."
  variant: 0
--- !u!114 &-1306255969988352927
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
