  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicEventMarker
  m_Time: 29.45
  action: 0
  speaker: "TR\u01AF\u1EDENG L\xC0NG"
  line: "Ta bi\u1EBFt c\u1EADu s\u1EBD n\xF3i nh\u01B0 v\u1EADy. H\xE3y chu\u1EA9n
    b\u1ECB th\u1EADt k\u1EF9 trang b\u1ECB r\u1ED3i \u0111i theo con \u0111\u01B0\u1EDDng
    ph\xEDa b\u1EAFc. N\u01A1i \u0111\xF3 r\u1EA5t nguy hi\u1EC3m."
  variant: 0
