  m_Script: {fileID: 11500000, guid: 780ddf4809df2a24a941bda7294e9746, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicEventMarker
  m_Time: 5.15
  action: 0
  speaker: "TR\u01AF\u1EDENG L\xC0NG"
  line: "C\u1EADu \u0111\u1EBFn \u0111\xFAng l\xFAc. S\xE1ng nay, s\u1EE9 gi\u1EA3
    c\u1EE7a nh\xE0 vua v\u1EEBa mang \u0111\u1EBFn m\u1ED9t s\u1EAFc l\u1EC7nh."
  variant: 0
--- !u!114 &5254234434795214774
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 780ddf4809df2a24a941bda7294e9746, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicEventMarker
  m_Time: 14.45
  action: 0
  speaker: "TR\u01AF\u1EDENG L\xC0NG"
  line: "M\u1ED9t con qu\xE1i v\u1EADt kh\u1ED5ng l\u1ED3 \u0111\xE3 xu\u1EA5t hi\u1EC7n
    t\u1EA1i v\xF9ng \u0111\u1EA5t ph\xEDa b\xEAn kia khu r\u1EEBng."
  variant: 0
--- !u!114 &5387215382145577726
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
