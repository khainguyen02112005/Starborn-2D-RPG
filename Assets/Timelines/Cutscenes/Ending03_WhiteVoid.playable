  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicEventMarker
  m_Time: 21.8
  action: 0
  speaker: "NH\xC2N V\u1EACT"
  line: "M\u1ED7i l\u1EA7n ta ng\xE3 xu\u1ED1ng, m\u1ECDi th\u1EE9 ch\u1EC9 b\u1EAFt
    \u0111\u1EA7u l\u1EA1i. C\xE1i ch\u1EBFt c\u1EE7a ta ch\u01B0a t\u1EEBng \u0111\u01B0\u1EE3c
    xem l\xE0 m\u1ED9t k\u1EBFt th\xFAc."
  variant: 0
